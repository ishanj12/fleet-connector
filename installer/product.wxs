<?xml version="1.0" encoding="utf-8"?>
<!--
  Fleet Connector MSI installer (§10). WiX v5 syntax — pinned to v5, not
  v6+, since v6 introduced a paid Open Source Maintenance Fee (EULA
  acceptance required); v5 predates it and needs no fee for CI use.

  Build (from the repo root, after building fleetconnect.exe for
  windows/amd64): install the WiX v5 dotnet global tool, add the Util
  extension, then run `wix build` against this file with the Util
  extension, x64 arch, FleetConnectExeSource bound to the built exe's
  path, and an output MSI path. See §10 and §14 for the exact CLI
  invocations, kept out of this comment since long-form CLI flags use a
  double hyphen, a sequence XML comments cannot contain.

  name/manufacturer/UpgradeCode below are placeholders — an adopting
  customer rebrands these (and the service DisplayName/Description) as
  their own product, same as the systemd unit's Description (§1's Preface,
  §9). UpgradeCode MUST stay fixed across versions once chosen — it is
  what MajorUpgrade uses to detect/replace an older install.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Fleet Connector"
           Manufacturer="Your Company"
           Version="0.1.1"
           UpgradeCode="7c9e6a1e-3f2b-4a5c-9d8e-1b2c3d4e5f60"
           Scope="perMachine"
           InstallerVersion="500">

    <SummaryInformation Description="Fleet Connector Installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Non-secret install-time properties (§10). MSI public properties
         (all-caps, no leading underscore) are settable on the msiexec
         command line: msiexec /i FleetConnector.msi /quiet
           FLEETCONNECT_INSTALL_DESCRIPTION="install:store-042"
           FLEETCONNECT_INSTALL_UPSTREAM="localhost:8080" ...
         Most RMM-driven fleets will prefer gen-config output staged
         directly at the fixed config path ahead of a plain silent
         install instead of using these properties at all (§10).
         Secure="yes" is required, not optional decoration: a Property
         with no Value and no Admin/Secure/Hidden marking is silently
         dropped by the linker (confirmed via `wix build`'s own WIX1006
         warning), and only secure properties are visible to the
         deferred EnsureConfig custom action below at all. -->
    <Property Id="FLEETCONNECT_INSTALL_DESCRIPTION" Secure="yes" />
    <Property Id="FLEETCONNECT_INSTALL_UPSTREAM" Secure="yes" />
    <Property Id="FLEETCONNECT_INSTALL_NAME" Secure="yes" />
    <Property Id="FLEETCONNECT_INSTALL_URL" Secure="yes" />
    <Property Id="FLEETCONNECT_INSTALL_METADATA" Secure="yes" />
    <Property Id="FLEETCONNECT_INSTALL_LOG_LEVEL" Secure="yes" />

    <!-- Credentials file path property — Secure="yes" so it's readable by
         the deferred custom action below; Hidden="yes" suppresses it from
         the verbose install log (§10). Only the *path* crosses into the
         deferred custom action's command line, never the authtoken value
         itself — gen-config's own file-based authtoken option (see
         gen_config.go) reads the actual secret at runtime, off the MSI
         property table entirely. -->
    <Property Id="FLEETCONNECT_CREDFILE" Secure="yes" Hidden="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FleetConnector" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="FleetConnectBinary">
        <File Id="FleetConnectExe"
              Source="$(var.FleetConnectExeSource)"
              Name="fleetconnect.exe"
              KeyPath="yes" />

        <!-- ServiceInstall/ServiceControl/util:ServiceConfig (§8, §10)
             handle registration, start/stop-on-upgrade, and crash-restart
             policy declaratively — no custom action needed for any of
             this. Start="auto" + the util:ServiceConfig restart actions
             give auto-start and crash-restart for free. -->
        <ServiceInstall Id="FleetConnectService"
                        Type="ownProcess"
                        Name="FleetConnector"
                        DisplayName="Fleet Connector"
                        Description="Packages the ngrok agent as a platform-native service instead of a script."
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart"
                               SecondFailureActionType="restart"
                               ThirdFailureActionType="restart"
                               RestartServiceDelayInSeconds="30" />
        </ServiceInstall>

        <!-- Start="install" would race gen-config's deferred custom
             action below (the service would start before config.yaml
             exists on a fresh, property-driven install). Instead,
             StartFleetConnectService (below) starts the service only
             after EnsureConfig has had a chance to run. -->
        <ServiceControl Id="FleetConnectServiceControl"
                        Name="FleetConnector"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Fleet Connector" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- Deferred, SYSTEM-context custom action re-invoking fleetconnect
         itself as `gen-config`, reusing the exact same config-
         construction/validation code the wizard uses (§10). The
         SetProperty-with-matching-Id + WixQuietExec pattern is the
         verified, correct way to get MSI property values into a deferred
         custom action's command line — deferred CAs cannot read [PROPERTY]
         references directly; they only see whatever the immediately-
         preceding, identically-Id'd SetProperty captured into
         CustomActionData. Only runs when FLEETCONNECT_INSTALL_DESCRIPTION
         was actually supplied — most installs will have staged
         config.yaml via gen-config ahead of time instead (§10) and skip
         this custom action's real work entirely (empty ExeCommand would
         still run gen-config with no args and fail fast, so this is
         gated by a Condition, not left to gen-config's own error path). -->
    <SetProperty Id="EnsureConfig"
                 Value="&quot;[#FleetConnectExe]&quot; gen-config --path &quot;[CommonAppDataFolder]FleetConnector\config.yaml&quot; --description &quot;[FLEETCONNECT_INSTALL_DESCRIPTION]&quot; --upstream &quot;[FLEETCONNECT_INSTALL_UPSTREAM]&quot; --name &quot;[FLEETCONNECT_INSTALL_NAME]&quot; --url &quot;[FLEETCONNECT_INSTALL_URL]&quot; --metadata &quot;[FLEETCONNECT_INSTALL_METADATA]&quot; --log-level &quot;[FLEETCONNECT_INSTALL_LOG_LEVEL]&quot; --authtoken &quot;file:[FLEETCONNECT_CREDFILE]&quot;"
                 Before="EnsureConfig"
                 Sequence="execute" />
    <CustomAction Id="EnsureConfig"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check"
                  BinaryRef="Wix4UtilCA_X64" />

    <SetProperty Id="StartFleetConnectService"
                 Value="&quot;sc.exe&quot; start FleetConnector"
                 Before="StartFleetConnectService"
                 Sequence="execute" />
    <CustomAction Id="StartFleetConnectService"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"
                  BinaryRef="Wix4UtilCA_X64" />

    <InstallExecuteSequence>
      <Custom Action="EnsureConfig" After="InstallServices" Condition="NOT Installed AND FLEETCONNECT_INSTALL_DESCRIPTION" />
      <!-- Runs on every fresh install, not just the property-driven path —
           EnsureConfig's own condition already limits its real work to when
           FLEETCONNECT_INSTALL_DESCRIPTION was actually supplied, but the
           service itself still needs to start immediately on the other two
           real paths too: a config.yaml pre-staged by an RMM ahead of
           install (§10/§11's "ship-and-run"), and nothing pre-staged at all
           (§6's wizard path) — both require the service to be running
           right after install, not just registered AUTO_START for the next
           reboot. After="EnsureConfig" keeps the ordering correct
           regardless of which of the three paths actually generated
           config.yaml. -->
      <Custom Action="StartFleetConnectService" After="EnsureConfig" Condition="NOT Installed" />
    </InstallExecuteSequence>

  </Package>
</Wix>
